.camera-card {
  padding: 34rpx;
  border-radius: 20rpx;
  background: #263238;
  color: #fffaf4;
}

.lens {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 360rpx;
  border-radius: 18rpx;
  background: radial-gradient(circle at center, #40545c 0%, #1b2428 70%);
}

.cat-silhouette {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 190rpx;
  height: 160rpx;
  border-radius: 58rpx;
  background: #f0b35c;
  color: #2b211a;
  font-size: 30rpx;
}

.cat-ear {
  position: absolute;
  top: -28rpx;
  width: 62rpx;
  height: 62rpx;
  background: #f0b35c;
  transform: rotate(45deg);
}

.cat-ear-left {
  left: 26rpx;
}

.cat-ear-right {
  right: 26rpx;
}

.cat-eye-row {
  letter-spacing: 22rpx;
}

.cat-nose {
  margin-top: 10rpx;
}

.camera-status {
  margin-top: 20rpx;
  color: #cfd8dc;
  font-size: 25rpx;
}

.actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 24rpx;
}

.rule-card {
  padding: 10rpx 26rpx;
}

.rule-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eadfd4;
  font-size: 26rpx;
  line-height: 1.45;
}

.rule-item:last-child {
  border-bottom: 0;
}

.rule-step {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: #1f8a70;
  color: #ffffff;
  font-weight: 800;
  flex-shrink: 0;
}

.capture {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 18rpx;
  padding: 18rpx;
}

.thumb {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 130rpx;
  height: 100rpx;
  border-radius: 12rpx;
  background: #d9eee6;
}

.mini-cat {
  color: #1f8a70;
  font-size: 28rpx;
  font-weight: 800;
}

.capture-info {
  flex: 1;
}

.capture-time {
  font-size: 28rpx;
  font-weight: 800;
}

.capture-meta {
  margin-top: 8rpx;
  color: #766d63;
  font-size: 24rpx;
}
