.camera-card {
  padding: 24rpx;
  border-radius: 20rpx;
  background: #263238;
  color: #fffaf4;
}

.latest-image,
.empty-preview {
  width: 100%;
  height: 380rpx;
  border-radius: 18rpx;
  background: #1b2428;
  overflow: hidden;
}

.tappable-image {
  transition: opacity 0.15s ease;
}

.tappable-image:active {
  opacity: 0.78;
}

.empty-preview {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #cfd8dc;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 800;
}

.empty-text {
  margin-top: 12rpx;
  font-size: 24rpx;
}

.camera-status {
  margin-top: 20rpx;
  color: #cfd8dc;
  font-size: 25rpx;
}

.actions {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.rule-card {
  padding: 10rpx 26rpx;
}

.rule-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eadfd4;
  font-size: 26rpx;
  line-height: 1.45;
}

.rule-item:last-child {
  border-bottom: 0;
}

.rule-step {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  background: #1f8a70;
  color: #ffffff;
  font-weight: 800;
  flex-shrink: 0;
}

.capture {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 18rpx;
  padding: 18rpx;
}

.thumb {
  width: 140rpx;
  height: 104rpx;
  border-radius: 12rpx;
  background: #d9eee6;
  flex-shrink: 0;
}

.placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #1f8a70;
  font-size: 24rpx;
  font-weight: 800;
}

.capture-info {
  flex: 1;
}

.capture-time {
  font-size: 28rpx;
  font-weight: 800;
}

.capture-meta {
  margin-top: 8rpx;
  color: #766d63;
  font-size: 24rpx;
}

.empty-list {
  padding: 28rpx;
  color: #766d63;
  font-size: 26rpx;
  text-align: center;
}
