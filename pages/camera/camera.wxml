<view class="page">
  <view class="camera-card">
    <view class="lens">
      <view class="cat-silhouette">
        <view class="cat-ear cat-ear-left"></view>
        <view class="cat-ear cat-ear-right"></view>
        <view class="cat-eye-row">● ●</view>
        <view class="cat-nose">▽</view>
      </view>
    </view>
    <view class="camera-status">PIR 红外检测 · YOLOv5-Nano 猫咪识别</view>
  </view>

  <view class="actions">
    <button class="primary-button" bindtap="takePhoto">远程拍照</button>
    <button class="ghost-button" bindtap="simulateDetect">模拟猫咪经过</button>
  </view>

  <view class="section-title">识别规则</view>
  <view class="rule-card card">
    <view class="rule-item">
      <text class="rule-step">1</text>
      <text>红外传感器检测到目标靠近喂食机</text>
    </view>
    <view class="rule-item">
      <text class="rule-step">2</text>
      <text>摄像头自动抓拍现场画面</text>
    </view>
    <view class="rule-item">
      <text class="rule-step">3</text>
      <text>识别结果为 cat 且置信度高于 0.6 时推送提醒</text>
    </view>
  </view>

  <view class="section-title">抓拍记录</view>
  <view class="capture-list">
    <view class="capture card" wx:for="{{captures}}" wx:key="id">
      <view class="thumb">
        <view class="mini-cat">cat</view>
      </view>
      <view class="capture-info">
        <view class="capture-time">{{item.time}}</view>
        <view class="capture-meta">{{item.type}} · 置信度 {{item.confidence}}</view>
      </view>
    </view>
  </view>
</view>
