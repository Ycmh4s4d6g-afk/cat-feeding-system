<view class="page home-page">
  <view class="hero">
    <view class="hero-copy">
      <view class="title">自动化喂养 · 智能交互</view>
      <view class="subtitle">设备 {{status.deviceOnline ? '在线' : '离线'}} · 最近更新 {{status.lastFeedTime}}</view>
    </view>
    <button
      class="feeder-toggle {{feederEnabled ? 'on' : ''}}"
      loading="{{feederSwitching}}"
      disabled="{{feederSwitching}}"
      bindtap="toggleFeeder"
    >
      <text class="toggle-label">喂食器</text>
      <text class="toggle-state">{{feederEnabled ? '关闭' : '打开'}}</text>
    </button>
  </view>

  <view class="quick-grid">
    <view class="metric card">
      <text class="metric-label">温度</text>
      <text class="metric-value">{{status.temperature}}°C</text>
    </view>
    <view class="metric card">
      <text class="metric-label">湿度</text>
      <text class="metric-value">{{status.humidity}}%</text>
    </view>
    <view class="metric card {{status.foodWeight <= status.lowFoodThreshold ? 'warning' : ''}}">
      <text class="metric-label">余量</text>
      <text class="metric-value">{{status.foodWeight}}g</text>
    </view>
  </view>

  <view class="notice card" wx:if="{{alert}}">
    <view class="notice-title">{{alert.title}}</view>
    <view class="notice-text">{{alert.message}}</view>
    <view class="notice-time" wx:if="{{alert.time}}">{{alert.time}}</view>
  </view>

  <view class="section-title">设置阈值</view>
  <view class="threshold-card card">
    <view class="threshold-row">
      <view>
        <view class="threshold-title">低粮阈值</view>
        <view class="threshold-desc">猫粮余量低于该值时告警</view>
      </view>
      <view class="threshold-input-wrap">
        <input
          class="threshold-input"
          type="digit"
          value="{{thresholdForm.lowFoodMax}}"
          bindinput="onLowFoodChange"
        />
        <text class="threshold-unit">g</text>
      </view>
    </view>

    <view class="threshold-row">
      <view>
        <view class="threshold-title">高温阈值</view>
        <view class="threshold-desc">温度高于该值时告警</view>
      </view>
      <view class="threshold-input-wrap">
        <input
          class="threshold-input"
          type="digit"
          value="{{thresholdForm.tempHighMin}}"
          bindinput="onTempHighChange"
        />
        <text class="threshold-unit">°C</text>
      </view>
    </view>

    <view class="threshold-actions">
      <button
        class="primary-button threshold-button"
        loading="{{thresholdSaving}}"
        disabled="{{thresholdSaving}}"
        bindtap="saveThresholds"
      >保存阈值</button>
      <button
        class="ghost-button threshold-button"
        loading="{{thresholdSaving}}"
        disabled="{{thresholdSaving}}"
        bindtap="resetThresholdSettings"
      >重置</button>
    </view>
  </view>
</view>
