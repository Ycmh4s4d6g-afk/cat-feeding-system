.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 280rpx;
  padding: 36rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #fff8ed 0%, #daf0e7 100%);
  box-sizing: border-box;
}

.eyebrow {
  color: #1f8a70;
  font-size: 22rpx;
  font-weight: 700;
}

.title {
  width: 410rpx;
  margin-top: 12rpx;
  font-size: 42rpx;
  line-height: 1.2;
  font-weight: 800;
}

.subtitle {
  margin-top: 16rpx;
  color: #776b60;
  font-size: 24rpx;
}

.cat-face {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 148rpx;
  height: 132rpx;
  border-radius: 44rpx;
  background: #f0b35c;
  color: #34251a;
  font-size: 26rpx;
  flex-shrink: 0;
}

.ear {
  position: absolute;
  top: -22rpx;
  width: 52rpx;
  height: 52rpx;
  background: #f0b35c;
  transform: rotate(45deg);
}

.ear.left {
  left: 18rpx;
}

.ear.right {
  right: 18rpx;
}

.eyes {
  letter-spacing: 18rpx;
}

.mouth {
  margin-top: 8rpx;
  font-size: 34rpx;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  margin-top: 24rpx;
}

.metric {
  padding: 24rpx 18rpx;
}

.metric-label {
  display: block;
  color: #776b60;
  font-size: 24rpx;
}

.metric-value {
  display: block;
  margin-top: 10rpx;
  font-size: 38rpx;
  font-weight: 800;
}

.warning .metric-value {
  color: #cf5c36;
}

.notice {
  margin-top: 22rpx;
  padding: 26rpx;
  border-left: 8rpx solid #cf5c36;
}

.notice-title {
  color: #cf5c36;
  font-size: 30rpx;
  font-weight: 800;
}

.notice-text {
  margin-top: 8rpx;
  color: #665b52;
  font-size: 25rpx;
  line-height: 1.5;
}

.actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.schedule {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding: 24rpx 28rpx;
}

.schedule-time {
  font-size: 34rpx;
  font-weight: 800;
}

.schedule-desc {
  margin-top: 6rpx;
  color: #766d63;
  font-size: 24rpx;
}
