.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 22rpx;
  min-height: 280rpx;
  padding: 36rpx;
  border-radius: 20rpx;
  background: linear-gradient(135deg, #fff8ed 0%, #daf0e7 100%);
  box-sizing: border-box;
}

.hero-copy {
  flex: 1;
  min-width: 0;
}

.title {
  font-size: 42rpx;
  line-height: 1.2;
  font-weight: 800;
}

.subtitle {
  margin-top: 16rpx;
  color: #776b60;
  font-size: 24rpx;
}

.feeder-toggle {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 168rpx;
  height: 132rpx;
  margin: 0;
  padding: 0;
  border-radius: 18rpx;
  background: #fffaf4;
  color: #4b4037;
  line-height: 1.2;
  box-shadow: 0 8rpx 20rpx rgba(58, 42, 26, 0.08);
  flex-shrink: 0;
}

.feeder-toggle::after {
  border: 0;
}

.feeder-toggle.on {
  background: #1f8a70;
  color: #ffffff;
}

.toggle-label {
  font-size: 23rpx;
  font-weight: 700;
}

.toggle-state {
  margin-top: 10rpx;
  font-size: 34rpx;
  font-weight: 800;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
  margin-top: 24rpx;
}

.metric {
  padding: 24rpx 18rpx;
}

.metric-label {
  display: block;
  color: #776b60;
  font-size: 24rpx;
}

.metric-value {
  display: block;
  margin-top: 10rpx;
  font-size: 38rpx;
  font-weight: 800;
}

.warning .metric-value {
  color: #cf5c36;
}

.notice {
  margin-top: 22rpx;
  padding: 26rpx;
  border-left: 8rpx solid #cf5c36;
}

.notice-title {
  color: #cf5c36;
  font-size: 30rpx;
  font-weight: 800;
}

.notice-text {
  margin-top: 8rpx;
  color: #665b52;
  font-size: 25rpx;
  line-height: 1.5;
}

.notice-time {
  margin-top: 10rpx;
  color: #9a8e82;
  font-size: 22rpx;
}

.actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}

.threshold-card {
  padding: 8rpx 26rpx 26rpx;
}

.threshold-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #eadfd4;
}

.threshold-title {
  color: #2c2925;
  font-size: 30rpx;
  font-weight: 800;
}

.threshold-desc {
  margin-top: 6rpx;
  color: #766d63;
  font-size: 24rpx;
}

.threshold-input-wrap {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 170rpx;
  height: 72rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: #f7efe7;
  box-sizing: border-box;
}

.threshold-input {
  width: 96rpx;
  color: #1f8a70;
  font-size: 30rpx;
  font-weight: 800;
  text-align: right;
}

.threshold-unit {
  margin-left: 8rpx;
  color: #766d63;
  font-size: 24rpx;
}

.threshold-actions {
  display: flex;
  gap: 18rpx;
  width: 100%;
  margin-top: 24rpx;
  box-sizing: border-box;
}

.threshold-button {
  width: 100%;
  min-width: 0;
  height: 76rpx;
  margin: 0;
  padding: 0;
  border-radius: 38rpx;
  font-size: 28rpx;
  box-sizing: border-box;
  line-height: 76rpx;
}
