<view class="page">
  <view class="summary card">
    <view>
      <view class="summary-label">当前余量</view>
      <view class="summary-value">{{status.foodWeight}}g</view>
    </view>
    <view class="summary-rule">低于 {{status.lowFoodThreshold}}g 自动提醒</view>
  </view>

  <view class="section-title">定时计划</view>
  <view class="form card">
    <view class="form-row">
      <text>时间</text>
      <picker mode="time" value="{{newTime}}" bindchange="onTimeChange">
        <view class="picker-value">{{newTime}}</view>
      </picker>
    </view>
    <view class="form-row">
      <text>份数</text>
      <view class="small-stepper">
        <button bindtap="minusSchedulePortion">-</button>
        <text>{{newPortions}}</text>
        <button bindtap="plusSchedulePortion">+</button>
      </view>
    </view>
    <button
      class="ghost-button"
      loading="{{scheduleSaving}}"
      disabled="{{scheduleSaving}}"
      bindtap="addSchedule"
    >添加计划</button>
  </view>

  <view class="schedule-list">
    <view class="schedule card" wx:for="{{schedules}}" wx:key="id">
      <view class="schedule-main">
        <view class="schedule-time">{{item.time}}</view>
        <view class="schedule-desc">出粮 {{item.portions}} 份 · {{item.durationSeconds}} 秒</view>
      </view>
      <view class="schedule-actions">
        <switch
          checked="{{item.enabled}}"
          disabled="{{updatingScheduleId === item.id}}"
          data-id="{{item.id}}"
          bindchange="toggleSchedule"
        />
        <view
          class="delete-button {{updatingScheduleId === item.id ? 'is-disabled' : ''}}"
          data-id="{{item.id}}"
          bindtap="deleteSchedule"
        >删除</view>
      </view>
    </view>
    <view class="empty-card card" wx:if="{{!schedules.length}}">暂无喂食计划</view>
  </view>

  <view class="section-title">喂食记录</view>
  <view class="records card">
    <view class="record" wx:for="{{records}}" wx:key="id">
      <text>{{item.time}}</text>
      <text>{{item.text}}</text>
    </view>
    <view class="empty-record" wx:if="{{!records.length}}">暂无喂食记录</view>
  </view>
</view>
