<view class="page">
  <view class="date-card card">
    <text>日期时间</text>
    <picker mode="date" value="{{selectedDate}}" bindchange="onDateChange">
      <view>{{selectedDate}}</view>
    </picker>
  </view>

  <view class="section-title">温湿度</view>
  <view class="chart card">
    <view class="chart-row" wx:for="{{trend}}" wx:key="time">
      <view class="chart-time">{{item.time}}</view>
      <view class="bar-wrap">
        <view class="temp-bar" style="width: {{item.temperature * 3}}%;"></view>
      </view>
      <view class="chart-value">{{item.temperature}}℃</view>
    </view>
    <view class="legend">
      <text class="temp-dot"></text>
      <text>温度趋势</text>
    </view>
  </view>

  <view class="section-title">余量曲线</view>
  <view class="chart card">
    <view class="chart-row" wx:for="{{trend}}" wx:key="time">
      <view class="chart-time">{{item.time}}</view>
      <view class="bar-wrap">
        <view class="food-bar" style="width: {{item.foodWeight}}%;"></view>
      </view>
      <view class="chart-value">{{item.foodWeight}}g</view>
    </view>
    <view class="legend">
      <text class="food-dot"></text>
      <text>猫粮余量</text>
    </view>
  </view>

  <view class="section-title">历史记录</view>
  <view class="records card">
    <view class="record" wx:for="{{records}}" wx:key="time">
      <text>{{item.time}}</text>
      <text>{{item.text}}</text>
    </view>
  </view>
</view>
