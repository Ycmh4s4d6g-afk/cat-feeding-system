.filter-card {
  padding: 26rpx;
}

.filter-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 18rpx;
}

.filter-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 78rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #f7efe7;
}

.filter-label {
  color: #766d63;
  font-size: 25rpx;
}

.filter-value {
  color: #1f8a70;
  font-size: 28rpx;
  font-weight: 800;
}

.filter-actions {
  display: flex;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 22rpx;
}

.filter-button {
  height: 76rpx;
  border-radius: 38rpx;
  font-size: 28rpx;
}

.weather-card,
.food-card {
  padding: 26rpx;
}

.weather-summary,
.food-summary {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-bottom: 18rpx;
}

.food-summary {
  grid-template-columns: 1fr;
}

.summary-item {
  padding: 20rpx;
  border-radius: 12rpx;
  background: #f7efe7;
}

.summary-label {
  display: block;
  color: #766d63;
  font-size: 23rpx;
}

.summary-value {
  display: block;
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 800;
}

.temp-text {
  color: #cf5c36;
}

.humidity-text {
  color: #1f8a70;
}

.food-text {
  color: #1f8a70;
}

.line-canvas {
  display: block;
  width: 100%;
  height: 360rpx;
}

.legend {
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-top: 18rpx;
  color: #766d63;
  font-size: 24rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.temp-dot,
.humidity-dot,
.food-dot {
  width: 18rpx;
  height: 18rpx;
  border-radius: 9rpx;
}

.temp-dot {
  background: #cf5c36;
}

.humidity-dot,
.food-dot {
  background: #1f8a70;
}

.records {
  padding: 10rpx 26rpx;
}

.record {
  display: flex;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #eadfd4;
  color: #4b4037;
  font-size: 25rpx;
}

.record:last-child {
  border-bottom: 0;
}
